{
  "name": "grimcraft-rts",
  "version": "1.0.0",
  "description": "Real-time strategy game built with Three.js / ECS",
  "type": "module",
  "scripts": {
    "dev": "npm run ai:compile && vite",
    "build": "npm run ai:compile && NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "ai:compile": "node --import tsx scripts/compile-ai.mjs",
    "sync-assets": "node scripts/sync-runtime-assets.mjs",
    "heroes:build": "node scripts/build-batch1-heroes.mjs",
    "heroes:build-all": "node scripts/build-batch1-heroes.mjs && node scripts/build-hero-batches.mjs",
    "heroes:icons": "node scripts/fetch-hero-icons.mjs",
    "creeps:build": "node scripts/build-melee-creeps.mjs",
    "maps:build-dota-surface": "node scripts/build-dota-surface.mjs",
    "models:r2:sync": "bash scripts/upload-models-r2.sh",
    "batches:r2:sync": "bash scripts/upload-batches-r2.sh",
    "assets:r2:sync": "bash scripts/upload-assets-r2.sh",
    "maps:r2:sync": "bash scripts/upload-maps-r2.sh",
    "maps:r2:sync-dota": "bash scripts/upload-dota-map-r2.sh",
    "preview": "vite preview",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 node --import ./tests/register-hooks.mjs --test tests/*.test.js",
    "test:ts": "NODE_OPTIONS=--max-old-space-size=4096 node --import tsx --test tests/*.test.ts",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=4096 tsc --noEmit"
  },
  "dependencies": {
    "@linaria/core": "^8.1.1",
    "@linaria/react": "^8.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@wyw-in-js/babel-preset": "^2.3.1",
    "@wyw-in-js/vite": "^2.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  }
}
